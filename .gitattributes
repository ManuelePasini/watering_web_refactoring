# Normalize text files to LF
* text=auto eol=lf

# Shell scripts must always use LF
*.sh text eol=lf

# Common config files
*.conf text eol=lf
*.env text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Keep binary files untouched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.gz binary
*.dump binary